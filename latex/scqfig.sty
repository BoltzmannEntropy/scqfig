% ---- the figure of the active style: \scqgraphics[width=\columnwidth]{t1_decay} loads
%      <figdir>/<style>/t1_decay, so one package option switches every figure
\newcommand{\scqstyle}{\scq@style}
\newcommand{\scqgraphics}[2][]{\includegraphics[#1]{\scq@figdir/\scq@style/#2}}

% ---- pgfplots: axis styles `scqfig field`, `scqfig folio` and `scqfig` (the active one),
%      plot styles `scqfig data`, `scqfig model`, `scqfig ref`
\AtBeginDocument{\@ifpackageloaded{pgfplots}{%
  \pgfplotscreateplotcyclelist{scqfig field}{%
    {scqFieldSeriesA,solid,mark=*,mark options={solid,fill=scqFieldSeriesA}},%
    {scqFieldSeriesB,solid,mark=square*,mark options={solid,fill=scqFieldSeriesB}},%
    {scqFieldSeriesC,solid,mark=diamond*,mark options={solid,fill=scqFieldSeriesC}},%
    {scqFieldSeriesD,solid,mark=triangle*,mark options={solid,fill=scqFieldSeriesD}},%
    {scqFieldSeriesE,solid,mark=triangle*,mark options={solid,fill=scqFieldSeriesE,rotate=180}}}
  \pgfplotsset{scqfig field/.style={axis lines=box,tick align=inside,xtick pos=both,ytick pos=both,
    axis line style={line width=0.7pt,draw=scqFieldInk},
    every tick/.style={line width=0.59pt,scqFieldInk},
    major tick length=3.2pt,minor tick length=1.8pt,
    tick label style={font=\sffamily\footnotesize},label style={font=\sffamily\small},
    legend style={font=\sffamily\footnotesize,draw=scqFieldInk,fill=white},
    every axis plot/.append style={line width=1.1pt,mark size=1.6pt},
    cycle list name=scqfig field,
    colormap={scqfig field}{rgb255(0)=(253,249,252) rgb255(300)=(232,179,212) rgb255(580)=(194,55,143) rgb255(820)=(94,42,132) rgb255(1000)=(0,0,0)}},
    scqfig field data/.style={only marks,mark=*,scqFieldData,mark options={solid,fill=scqFieldData}},
    scqfig field model/.style={no marks,solid,scqFieldModel,line width=1.1pt},
    scqfig field ref/.style={no marks,scqFieldReference,dash pattern=on 4pt off 2pt,line width=0.7pt},
  }
  \pgfplotscreateplotcyclelist{scqfig folio}{%
    {scqFolioSeriesA,solid,mark=*,mark options={solid,fill=white}},%
    {scqFolioSeriesB,dashed,mark=square*,mark options={solid,fill=white}},%
    {scqFolioSeriesC,dash dot,mark=triangle*,mark options={solid,fill=white}},%
    {scqFolioSeriesD,dotted,mark=diamond*,mark options={solid,fill=white}},%
    {scqFolioSeriesE,dash pattern=on 5pt off 1.5pt on 1pt off 1.5pt on 1pt off 1.5pt,mark=triangle*,mark options={solid,fill=white,rotate=180}}}
  \pgfplotsset{scqfig folio/.style={axis lines*=left,axis line style={-},tick align=outside,xtick pos=left,ytick pos=left,
    axis line style={line width=0.6pt,draw=scqFolioInk},
    every tick/.style={line width=0.51pt,scqFolioInk},
    major tick length=3.2pt,minor tick length=1.8pt,
    tick label style={font=\rmfamily\footnotesize},label style={font=\rmfamily\small},
    legend style={font=\rmfamily\footnotesize,draw=none,fill=white},
    every axis plot/.append style={line width=0.9pt,mark size=1.6pt},
    cycle list name=scqfig folio,
    colormap={scqfig folio}{rgb255(0)=(255,255,255) rgb255(400)=(154,183,226) rgb255(750)=(31,95,191) rgb255(1000)=(0,0,0)}},
    scqfig folio data/.style={only marks,mark=*,scqFolioData,mark options={solid,fill=white}},
    scqfig folio model/.style={no marks,solid,scqFolioModel,line width=0.9pt},
    scqfig folio ref/.style={no marks,scqFolioReference,dash pattern=on 4pt off 2pt,line width=0.7pt},
  }
  \pgfplotsset{scqfig/.style={scqfig \scq@style},
    scqfig data/.style={scqfig \scq@style\space data},
    scqfig model/.style={scqfig \scq@style\space model},
    scqfig ref/.style={scqfig \scq@style\space ref}}%
}{}%
\@ifpackageloaded{tikz}{%
  \tikzset{scq tile/.style={rounded corners=2pt,inner sep=3pt,scq tile fill/#1},
    scq tile/.default=capacitive,
    scq tile fill/nonlinear/.style={fill=scqTileNonlinear},
    scq tile fill/capacitive/.style={fill=scqTileCapacitive},
    scq tile fill/inductive/.style={fill=scqTileInductive},
    scq tile fill/coupling/.style={fill=scqTileCoupling}}%
