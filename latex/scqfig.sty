%   \usepackage[field]{scqfig}   or   \usepackage[folio,figdir=figures]{scqfig}
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{scqfig}[2026/10/23 v0.1.0 figure styles for superconducting-chip papers]
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=scq,prefix=scq@}
\def\scq@style{field}\def\scq@Style{Field}
